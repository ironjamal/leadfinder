"use client";

import { useState } from "react";
import { Business } from "@/lib/types";
import { buildTelUrl, buildWhatsAppUrl } from "@/lib/phone";
import StatusBadge from "./StatusBadge";
import OpportunityTag from "./OpportunityTag";

interface Props {
  business: Business;
  isSaved: boolean;
  onSave: (business: Business) => void;
}

const actionButtonClasses =
  "rounded-lg border border-fg/20 px-3 py-1.5 text-sm text-fg hover:border-fg/40";

export default function BusinessCard({ business, isSaved, onSave }: Props) {
  const [copied, setCopied] = useState(false);

  async function handleCopy() {
    if (!business.phone) return;
    try {
      await navigator.clipboard.writeText(business.phone);
      setCopied(true);
      setTimeout(() => setCopied(false), 1500);
    } catch {
      // Clipboard API may be unavailable; nothing to recover here.
    }
  }

  return (
    <div className="flex flex-col gap-3 rounded-xl border border-fg/10 bg-white/[0.02] p-5">
      <div className="flex items-start justify-between gap-3">
        <div className="min-w-0">
          <h3 className="truncate text-lg font-semibold text-fg">{business.name}</h3>
          <p className="text-sm text-muted">{business.category}</p>
        </div>
        <StatusBadge status={business.websiteStatus} />
      </div>

      {business.websiteStatus === "none" && <OpportunityTag />}

      <p className="text-sm text-fg/80">{business.address}</p>

      <div className="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
        <span>{business.phone || "Phone unavailable"}</span>
        <span>
          {business.rating !== null ? `★ ${business.rating.toFixed(1)}` : "No rating"}
          {business.reviewCount !== null ? ` (${business.reviewCount} reviews)` : ""}
        </span>
      </div>

      <div className="mt-1 flex flex-wrap items-center gap-2">
        <a
          href={business.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          className={actionButtonClasses}
        >
          Open in Google Maps
        </a>

        {business.website && (
          <a href={business.website} target="_blank" rel="noopener noreferrer" className={actionButtonClasses}>
            Visit Website
          </a>
        )}

        {business.phone && (
          <a href={buildTelUrl(business.phone)} className={actionButtonClasses}>
            Call
          </a>
        )}

        {business.phone && (
          <button onClick={handleCopy} className={actionButtonClasses}>
            {copied ? "Copied!" : "Copy Number"}
          </button>
        )}

        {business.phoneWhatsApp && (
          <a
            href={buildWhatsAppUrl(business.phoneWhatsApp)}
            target="_blank"
            rel="noopener noreferrer"
            className={actionButtonClasses}
          >
            WhatsApp
          </a>
        )}

        <button
          onClick={() => onSave(business)}
          disabled={isSaved}
          className="ml-auto rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-fg transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
        >
          {isSaved ? "Saved ✓" : "Save Lead"}
        </button>
      </div>
    </div>
  );
}
